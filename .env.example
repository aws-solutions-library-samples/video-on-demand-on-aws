# Video on Demand on AWS (v7.0.0) deploy-time parameters, for the core stack AND every companion stack.
#
# Copy to `.env` at the repo root (git-ignored) and edit. Every CDK app (source/core, source/cms and any
# companion module) and every deploy script loads this one file and maps each UPPER_SNAKE var to the
# matching camelCase CDK context key, so you deploy with a plain `npm run cdk -- deploy` instead of
# long `-c key=value` command lines. An explicit `-c key=value` (or a value in cdk.json) still
# overrides the value here. Set VOD_ENV_FILE=<path> to use a different file (e.g. .env.prod).
# Values are validated at synth (source/core/lib/context.ts for the core stack).

# --- Required ---
# SNS subscription address for workflow notifications. Synth fails without it.
EMAIL=you@example.com

# --- Core (optional; defaults shown) ---
# Physical CloudFormation stack name + SSM discovery-param prefix (/<STACK_NAME>/...).
STACK_NAME=VideoOnDemand
# SNS success/failure notifications.
ENABLE_SNS=true
# SQS publish of completed-asset messages.
ENABLE_SQS=false
# Source archiving after publish: NONE | GLACIER | DEEP_ARCHIVE.
ARCHIVE_SOURCE=NONE
# CloudFront price class: PriceClass_100 | PriceClass_200 | PriceClass_All.
PRICE_CLASS=PriceClass_All
# CloudFront geo restriction, comma-separated ISO country codes (e.g. US,CA). Omit = none.
# GEO_RESTRICTION=
# Existing WAFv2 WebACL ARN (CLOUDFRONT scope, us-east-1) to associate with CloudFront. Omit = none.
# WAF_WEB_ACL_ARN=
# Custom domain + ACM certificate (us-east-1) for the distribution; set both or neither. With them the
# distribution enforces a TLSv1.2_2021 minimum (the default *.cloudfront.net domain is fixed at TLSv1).
# DOMAIN_NAME=video.example.com
# CERTIFICATE_ARN=arn:aws:acm:us-east-1:111122223333:certificate/<id>
# Expire destination objects after N days. Omit = no expiry.
# DESTINATION_RETENTION_DAYS=
# Browser origins allowed to upload to the source bucket (operator-console self-service upload).
# '*' or comma-separated http(s)://host[:port] origins. Omit = no source-bucket CORS.
# UPLOAD_CORS_ORIGINS=http://localhost:5174

# --- Packaging overlay (default OFF; OFF keeps the GA CMAF template byte-identical) ---
# Two-job REMUX_ALL packaging overlay (HLS/TS + CMAF-HLS + DASH): OFF | ON.
PACKAGING_PROFILE=OFF

# --- Other overlays (default OFF except THUMBNAILS_PROFILE, which defaults ON; byte-identical when OFF) ---
# SCTE-35 ad-markers via per-asset ESAM sidecar: OFF | ON.
AD_MARKERS_PROFILE=OFF
# MediaConvert per-frame quality-metric CSV reports (VMAF/QVBR/SHOT_CHANGE): OFF | ON.
PER_FRAME_METRICS=OFF
# Captions/subtitles from a per-asset <source>.vtt sidecar (WebVTT on HLS/CMAF, IMSC on DASH): OFF | ON.
CAPTIONS_PROFILE=OFF
# MediaConvert thumbnails/poster (FRAME_CAPTURE) under <guid>/thumbnails/: OFF | ON. Defaults ON (the
# one overlay that does) — set OFF here to opt out.
THUMBNAILS_PROFILE=ON

# --- Companion stacks (read by scripts/deploy-wizard.sh, not by the core stack) ---
# Deploy the operator web app (CMS, stack <STACK_NAME>-cms) after the core stack: true | false.
DEPLOY_CMS=false
# CMS environment: prod (retains the user pool, requires MFA) | dev (deletes everything with the stack).
# CMS_ENVIRONMENT=prod
# Operator username the deploy wizard creates on the first CMS deploy (Cognito emails EMAIL a temporary
# password); later deploys find it and skip that step.
# CMS_ADMIN_USER=admin
# WAF allow-list (source/modules/waf, a separate us-east-1 stack): a default-block WebACL that allows only
# these viewer countries and/or IPv4 CIDRs (allowed if either matches). Setting either one makes the deploy
# wizard deploy it and save its ARN as WAF_WEB_ACL_ARN. Distinct from GEO_RESTRICTION above.
# WAF_ALLOWED_COUNTRIES=US,CA,GB
# WAF_ALLOWED_IPS=203.0.113.0/24

# --- Extensions ---
# Installed extensions to enable, comma-separated (core stack + CMS). None ship in this repository; an
# installed extension (source/core/extensions/<name>, source/cms/.../extensions/<name>) documents its own
# keys in its env.example. A listed name that isn't installed fails synth.
# VOD_EXTENSIONS=
