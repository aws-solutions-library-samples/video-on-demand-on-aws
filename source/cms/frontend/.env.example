# VOD CMS (operator web app) frontend config.
# These are produced by the backend CDK stacks and written here by scripts/deploy-all.sh
# (or copy them from the auth/api stack outputs by hand for local dev). Never hardcode pool ids.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_IDENTITY_POOL_ID=
VITE_API_URL=

# Self-service upload (Amplify Storage direct-to-S3). VITE_UPLOAD_BUCKET = the VOD source bucket name
# (from the /<vodStackName>/SourceBucket SSM param); VITE_UPLOAD_REGION defaults to the Cognito region.
VITE_UPLOAD_BUCKET=
VITE_UPLOAD_REGION=
